# Agent Interaction Lab — LLM Provider Configuration
#
# Copy this to .env and fill in your API keys.
# Or use "Provider setup" in the interactive CLI: npm run agentlab
#
# Heuristic mode (model: "heuristic-mini") needs no API key.
# LLM mode requires at least one provider.

# --- Anthropic (Claude models) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (GPT models) ---
# OPENAI_API_KEY=sk-...

# --- OpenRouter (models addressed as provider/model) ---
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Custom endpoint (OpenAI-compatible, e.g. Ollama, vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

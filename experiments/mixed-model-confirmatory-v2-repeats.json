{
  "id": "mixed_model_confirmatory_v2_repeats",
  "title": "Mixed-model capability confirmation, symmetric repeats",
  "benchmarkMeta": {
    "status": "supporting",
    "locked": true,
    "notes": [
      "Confirmatory extension of mixed_model_capability_pilot_v1.",
      "Every run uses ego depletion, three liar agents, three neutral agents, standard shared memory, 18 calls, temperature 0, and one of the same twelve balanced speaking orders.",
      "Prompts, numeric profiles, identities, question, condition, call budget, and speaking orders remain fixed. Only the model assigned to liar and neutral roles changes.",
      "Primary outcomes are final neutral-agent false endorsement, any neutral adoption, complete neutral adoption, and liar-role retention.",
      "The primary analysis estimates liar-model, neutral-model, and interaction effects. It does not claim a general intelligence scaling law.",
      "This locked repeat stage applies seeds 1 and 2 to all nine model pairings, irrespective of Stage 1 outcomes.",
      "Together with the seed-0 pilot and Stage 1, it yields three provider repeats for every pairing."
    ]
  },
  "scenarios": [
    "scenarios/familiar-blind/neutral-ratio-standardized-v2/neutral_ratio_standardized_v2_ego_3of6.yaml"
  ],
  "conditions": [
    "conditions/shared-memory-no-correction.yaml"
  ],
  "seeds": [
    1,
    2
  ],
